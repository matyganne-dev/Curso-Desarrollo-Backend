<h1 class="titulo-principal"><%= titulo %></h1>
<h2 class="titulo-secundario"><%= seccion %></h2>

<% if (reservas.length === 0) { %>
  <p>No hay reservas activas en este momento.</p>
<% } else { %>
  <ul class="lista-reservas">
    <% reservas.forEach(reserva => { %>
      <li class="tarjeta">
        <span><strong><%= reserva.estudiante %></strong> reservó la <strong><%= reserva.sala %></strong></span>
        <span>Para el día <%= reserva.fecha %> (<%= reserva.turno %>).</span>
        <a href="/reservas/<%= reserva.id %>" class="etiqueta">Ver detalle completo</a>
      </li>
    <% }) %>
  </ul>
<% } %>

<a href="/reservas/nueva" class="btn-primario">Crear una nueva reserva</a>