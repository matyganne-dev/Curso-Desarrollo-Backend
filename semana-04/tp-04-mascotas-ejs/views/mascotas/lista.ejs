<section>
    <header>
        <h1>
            <%= titulo %>
        </h1>
        <a href="/mascotas/nueva" class="header-btn">Dar en adopción</a>
    </header>

    <% if (mascotas.length===0) { %>
        <p>En este momento no tenemos mascotas esperando adopción.</p>
        <% } else { %>

            <div class="grilla">
                <% mascotas.forEach((mascota)=> { %>
                    <article class="tarjeta" style="--bg-mascota: url('<%= mascota.imagen %>');">

                        <h2>
                            <%= mascota.nombre %>
                        </h2>
                        <div class="items">
                            <p><strong>Especie:</strong>
                                <%= mascota.especie %>
                            </p>
                            <p><strong>Edad:</strong>
                                <%= mascota.edad %> años
                            </p>
                            <p><strong>Estado:</strong>
                                <%= mascota.estado %>
                            </p>
                        </div>
                        <a href="/mascotas/<%= mascota.id %>">Ver detalle de <%= mascota.nombre %></a>
                    </article>
                    <% }) %>
            </div>

            <% } %>
</section>